<?php
// Repeatable from/to rows (#27). The .cfg wire format is unchanged - a single
// semicolon-joined `from=>to` string - so rc.preloadd and the engine are
// untouched; only the editing surface differs.
//
// The hidden field below carries the SAVED value and is rewritten by
// pathmaps.js only when a row is edited. Without JS the rows are inert but the
// hidden field still posts the saved value, so a script failure costs the
// ability to edit, never the mapping itself. That matters because /update.php
// overlays posted keys onto the existing .cfg: a posted-EMPTY value would
// overwrite a good one, while an unposted key survives.
$wapMapRows = [];
foreach (explode(';', (string) ($wapCfg['PATH_MAPS'] ?? '')) as $wapChunk) {
    $wapAt = strpos($wapChunk, '=>');
    if ($wapAt === false) {
        continue; // not a pair; drop rather than render a half row
    }
    $wapFrom = trim(substr($wapChunk, 0, $wapAt));
    $wapTo   = trim(substr($wapChunk, $wapAt + 2));
    if ($wapFrom !== '' && $wapTo !== '') {
        $wapMapRows[] = ['from' => $wapFrom, 'to' => $wapTo];
    }
}
if ($wapMapRows === []) {
    $wapMapRows[] = ['from' => '', 'to' => '']; // always one editable row
}
?>
