<?php

/*
 * Watch-Aware Preloader settings + status page. MIT-licensed.
 * Reads the engine's status.json (read-only) and, in Task 4, renders the
 * settings form. No secrets are ever rendered here.
 */

$docroot = $docroot ?? ($_SERVER['DOCUMENT_ROOT'] ?? '/usr/local/emhttp');
require_once "{$docroot}/plugins/watch-aware-preloader/include/status.php";
require_once "{$docroot}/plugins/watch-aware-preloader/include/paths.php";

$wapStatusPath = wap_default_status_path();
$wapStatus     = wap_read_status($wapStatusPath);
// Last connection-test result (#36), persisted by `rc.preloadd test` so it
// survives the transient /update.php progress popup.
$wapLastTest   = wap_read_last_test(wap_default_last_test_path());
$wapEstimate   = wap_read_estimate(wap_default_estimate_path());

$wapCfg = \function_exists('parse_plugin_cfg') ? parse_plugin_cfg('watch-aware-preloader') : [];
// Declare $var explicitly: Unraid populates it in the page's including scope, but
// naming it global here guards against an empty CSRF token if the include ever
// happens inside a function scope.
global $var;
$wapCsrf = $var['csrf_token'] ?? '';
require_once "{$docroot}/plugins/watch-aware-preloader/include/secrets.php";
$wapKeySet = wap_api_key_is_set(wap_default_secret_path());
require_once "{$docroot}/plugins/watch-aware-preloader/include/pickers.php";
$wapPickers    = wap_read_pickers(wap_default_pickers_path());
$wapServerUrl  = (string) ($wapCfg['SERVER_URL'] ?? 'http://localhost:8096');
$wapConnected  = wap_pickers_fresh($wapPickers, $wapServerUrl);
// Current selections (csv of ids, or legacy names) for checkbox state.
$wapSelUsers   = array_filter(array_map('trim', explode(',', (string) ($wapCfg['USERS'] ?? ''))), static fn (string $s): bool => $s !== '');
$wapSelLibs    = array_filter(array_map('trim', explode(',', (string) ($wapCfg['LIBRARIES'] ?? ''))), static fn (string $s): bool => $s !== '');
// Preserve the current selection as a hidden scalar in the gate / empty states:
// no USERS[]/LIBRARIES[] checkbox is posted there, so presave would normalize the
// field to "" and silently clear a saved selection on any unrelated save.
$wapCurUsers   = implode(',', $wapSelUsers);
$wapCurLibs    = implode(',', $wapSelLibs);
// Auto-detected path-map rules for the read-only table (hoisted so the inline
// island below opens directly with the connect-gate check).
$wapMaps       = wap_picker_pathmaps($wapPickers);
$wapRules      = (\is_array($wapMaps['rules'] ?? null)) ? $wapMaps['rules'] : [];
// Signal tiers keyed by the ENGINE's tier token (what lands in a TIER_ORDER csv
// and what rc.preloadd's tier_csv_filter accepts): token => [cfg-prefix, label].
// The token is the wire format; the cfg-prefix only names the legacy dial keys.
$wapAllTiers = [
    'resume' => ['RESUME', 'Resume points'],
    'nextup' => ['NEXTUP', 'Next-up episodes'],
    'recent' => ['RECENT', 'Recently added'],
];

// Reuse presave's normalizer so the page and the save path cannot drift on which
// tier tokens are legal: one vocabulary, one implementation. Pure transforms, no
// I/O, so including it here is free.
require_once "{$docroot}/plugins/watch-aware-preloader/include/settings.php";

/**
 * Split a normalized tier-order csv into a list of tokens.
 *
 * @return list<string>
 */
$wapOrderList = static function (mixed $csv): array {
    $out = wap_cfg_tier_order($csv);

    return $out === '' ? [] : explode(',', $out);
};

/**
 * Rows to render for an order list: the saved order first, then every remaining
 * tier appended UNTICKED. A tier disabled by omission stays visible and
 * re-enableable rather than vanishing from the UI with no way back.
 *
 * @param list<string> $order
 * @return list<string>
 */
$wapOrderRows = static function (array $order) use ($wapAllTiers): array {
    $rows = $order;
    foreach (array_keys($wapAllTiers) as $t) {
        if (!\in_array($t, $rows, true)) {
            $rows[] = $t;
        }
    }

    return $rows;
};

// The GLOBAL order. An ABSENT TIER_ORDER key means a pre-feature .cfg: derive the
// order from the legacy *_ENABLED flags, exactly as rc.preloadd's
// legacy_order_from_flags does, so the page and the engine agree. An EMPTY (but
// present) TIER_ORDER is an explicit "warm nothing" and must stay empty.
if (\array_key_exists('TIER_ORDER', $wapCfg)) {
    $wapOrder = $wapOrderList($wapCfg['TIER_ORDER']);
} else {
    $wapOrder = [];
    foreach ($wapAllTiers as $wapTok => [$wapPfx]) {
        if (\in_array(strtolower((string) ($wapCfg["TIER_{$wapPfx}_ENABLED"] ?? '1')), ['1', 'true', 'yes', 'on'], true)) {
            $wapOrder[] = $wapTok;
        }
    }
}
$wapTierRows = $wapOrderRows($wapOrder);

/**
 * The .cfg key suffix for a user id, or null when the id cannot form one.
 * Unraid .cfg keys cannot hold '-' but Emby ids are dashed GUIDs, so the page
 * posts TIER_ORDER_<id with '-' as '_'>. rc.preloadd discovers overrides from
 * these keys and emits the ORIGINAL dashed id as the TOML key when it can recover
 * it from the enabled-users csv, otherwise the underscored suffix as-is - the
 * engine binds either form (app.resolveUserKey's refCfgKey tier). An id that is
 * not [A-Za-z0-9_] after the transform can never form a .cfg key at all, so
 * return null and the page renders no override control for it rather than a dead
 * one. The regex is kept genuinely equivalent to cfg_key_safe's
 * byte-based [A-Za-z0-9_] check: the 'D' modifier is required, or PHP's '$'
 * matches before a trailing newline and accepts an id (e.g. "abc\n") that
 * cfg_key_safe rejects, rendering a dead override control.
 */
$wapCfgKeyId = static function (string $id): ?string {
    $key = strtr($id, '-', '_');

    return preg_match('/^[A-Za-z0-9_]+$/D', $key) === 1 ? $key : null;
};

/**
 * Count how many of the server's users map onto each .cfg key suffix.
 *
 * strtr('-','_') is NOT injective, so ids "a-b" and "a_b" both produce the field
 * name TIER_ORDER_a_b. Two rows would then render the SAME name: PHP keeps the
 * last posted value, so one user's override is destroyed on every save, and
 * querySelector binds both toggles to the first panel. rc.preloadd and
 * resolveUserKey both REFUSE a normalized collision rather than guess; the UI must
 * not be the one layer that silently clobbers. Any suffix claimed by more than one
 * user gets no override control at all - the same treatment as an id that cannot
 * form a key.
 *
 * @param list<array{id?:string,name?:string}> $users
 * @return array<string,int>
 */
$wapKeyIdCounts = static function (array $users) use ($wapCfgKeyId): array {
    $counts = [];
    foreach ($users as $u) {
        $id = (string) ($u['id'] ?? '');
        if ($id === '') {
            continue;
        }
        $k = $wapCfgKeyId($id);
        if ($k !== null) {
            $counts[$k] = ($counts[$k] ?? 0) + 1;
        }
    }

    return $counts;
};

// Saved per-user overrides, re-posted as hidden scalars in the connect-gate /
// empty states.
//
// NOT for the reason the obvious one: /update.php MERGES rather than rewrites (it
// seeds its key map from the existing .cfg and overlays POST), so a key nobody
// posts SURVIVES and these overrides would persist regardless. The re-post is
// belt-and-braces that keeps the posted state a faithful picture of the saved
// state, and it costs nothing. Contrast $wapCurUsers above, whose re-post IS
// load-bearing for a different reason: the presave materializes USERS
// unconditionally, so an unposted USERS becomes '' rather than surviving.
// The 'TIER_ORDER_' prefix cannot catch the global 'TIER_ORDER' (no trailing
// underscore).
$wapSavedOverrides = [];
foreach ($wapCfg as $wapK => $wapV) {
    if (\is_string($wapK) && str_starts_with($wapK, 'TIER_ORDER_') && \is_scalar($wapV)) {
        $wapSavedOverrides[$wapK] = (string) $wapV;
    }
}
?>

<table class="tablesorter shift ups">
<thead><tr><th>Watch-Aware Preloader - settings</th></tr></thead>
</table>

<?php
// The meter has two possible sources, and they answer DIFFERENT questions.
//
//   estimate.json - what the CURRENT selection would warm. More specific, and
//                   live: meter.js repaints it as controls change. But
//                   rc.preloadd's render() deletes it on every save, precisely
//                   so a projection computed under superseded settings is never
//                   shown - so it is absent most of the time.
//   status.json   - what the LAST SWEEP actually warmed. Always present after a
//                   run, survives saves, needs no operator action (#114).
//
// The projection wins when it exists, because "what would my current selection
// do" is the more useful answer while editing. Otherwise show the last run, so
// the page is never blank when the engine has actually run.
//
// A FAILED run renders no bar: its byte counts describe a sweep that did not
// complete, and a confident-looking bar over them would misreport.
$wapMeterSource = null;
if ($wapEstimate !== null) {
    $wapMeterSource = 'estimate';
} elseif ($wapStatus !== null && !empty($wapStatus['ok']) && (int) ($wapStatus['budget_bytes'] ?? 0) > 0) {
    $wapMeterSource = 'status';
}
?>
<?php if ($wapMeterSource === 'estimate') {
    // Inert JSON data island. JSON_HEX_TAG escapes < and > to < / > so a
    // "</script>" in any value cannot break out of the <script> element (this is
    // the breakout guard; do not drop it). JSON_UNESCAPED_SLASHES keeps paths
    // readable. Rows are already anonymized {u,t,l,b,r} - no id/title.
    $wapEstJson = json_encode($wapEstimate, JSON_UNESCAPED_SLASHES | JSON_HEX_TAG);
    ?>
<div id="wap-meter" class="wap-meter" data-state="ok">
    <div class="wap-meter-label">Projected warm set
        <?php if (!empty($wapEstimate['meta']['ceiling_truncated'])) { ?>
        <span class="wap-meter-note">(estimate capped at <?= (int) ($wapEstimate['ceiling_per_user_tier'] ?? 0) ?>/tier)</span>
        <?php } ?>
    </div>
    <div class="wap-bar"><div class="wap-bar-fill"></div></div>
    <div class="wap-meter-text"></div>
    <div class="wap-drop" style="display:none"></div>
    <div class="wap-stale" style="display:none"></div>
</div>
<script type="application/json" id="wap-estimate"><?= $wapEstJson ?></script>
<?php
    /*
     * Kept HERE, immediately after the island it reads, rather than with the
     * other script tags at the end of the page. meter.js is useless without
     * #wap-estimate and #wap-estimate is inert without meter.js, so the two
     * belong in one place: separating them is what let the include go missing
     * unnoticed once already (#121). The status branch below is deliberately
     * server-rendered and loads no JavaScript at all.
     */
    ?>
<script src="/plugins/watch-aware-preloader/js/meter.js"></script>
<?php } elseif ($wapMeterSource === 'status') {
    // Rendered server-side: this is a fixed historical fact, not a projection
    // that reacts to the form, so it needs no JavaScript and is correct with
    // scripting disabled.
    //
    // LABEL CARE: bytes_warmed counts what THIS SWEEP warmed. Items already
    // resident are counted in `skipped` and contribute nothing, so in a healthy
    // steady state this number trends toward zero. Calling it "warm set" would
    // make a working preloader look like a failing one - hence "warmed on the
    // last run", with the skipped count alongside so a small bar reads as
    // "little left to do" rather than "nothing is cached". The skipped clause
    // describes ONLY the skipped items: an earlier wording said "nothing was
    // re-read", which contradicts a nonzero warmed figure on the same line
    // whenever a sweep both warmed some items and skipped others - the common
    // case, not an edge one.
    $wapBudget  = (int) ($wapStatus['budget_bytes'] ?? 0);
    $wapWarmed  = (int) ($wapStatus['bytes_warmed'] ?? 0);
    $wapPct     = $wapBudget > 0 ? min(100.0, $wapWarmed / $wapBudget * 100) : 0.0;
    $wapSkipped = (int) ($wapStatus['skipped'] ?? 0);
    ?>
<div id="wap-meter" class="wap-meter" data-state="ok">
    <div class="wap-meter-label">Warmed on the last run
        <span class="wap-meter-note">(<?= htmlspecialchars(wap_format_pacific((string) ($wapStatus['last_run'] ?? ''))) ?>)</span>
    </div>
    <div class="wap-bar"><div class="wap-bar-fill" style="width: <?= number_format($wapPct, 1, '.', '') ?>%"></div></div>
    <div class="wap-meter-text"><?php
    if ($wapWarmed === 0 && $wapSkipped > 0) {
        // Nothing warmed BECAUSE nothing needed warming. Leading with "0.0 GiB"
        // here reads as a failure - it was misread as an error by the
        // maintainer himself, which is the strongest possible evidence the
        // number needs a verdict in front of it rather than after it.
        ?>Everything already cached - <?= $wapSkipped === 1 ? 'the 1 item was' : 'all ' . $wapSkipped . ' items were' ?> resident, so nothing needed warming<?php
    } else { ?><?= htmlspecialchars(wap_gib($wapWarmed)) ?> warmed of <?= htmlspecialchars(wap_gib($wapBudget)) ?> budget<?php if ($wapSkipped > 0) { ?>, plus <?= $wapSkipped ?> item<?= $wapSkipped === 1 ? '' : 's' ?> already cached<?php } ?><?php } ?></div>
</div>
<blockquote class="inline_help">What the last sweep actually warmed, not what is cached right now - items already resident are skipped and add nothing to the bar, so an empty bar on a healthy system means there was nothing left to do. Click <strong>Estimate budget</strong> to project your current selection instead.</blockquote>
<?php } else { ?>
<blockquote class="inline_help">Click <strong>Estimate budget</strong> to project your current selection against the cache budget.</blockquote>
<?php } ?>

<?php
/*
 * Save via /update.php, which runs as ROOT - the only context that can write the
 * 0600-root FAT flash files. In one request it: runs the #include hook
 * (presave.php: writes secrets.toml and normalizes the settings), then writes the
 * .cfg from the posted fields (#file), then runs rc.preloadd render (#command).
 * The API key is posted as #api_key so /update.php excludes it from the .cfg
 * (fields prefixed with # are not written to the file).
 */
?>
<form markdown="false" name="wap_settings" method="POST" action="/update.php" target="progressFrame">
<input type="hidden" name="csrf_token" value="<?= htmlspecialchars($wapCsrf) ?>">
<input type="hidden" name="#file" value="watch-aware-preloader/watch-aware-preloader.cfg">
<input type="hidden" name="#include" value="plugins/watch-aware-preloader/include/presave.php">
<input type="hidden" name="#command" value="/usr/local/emhttp/plugins/watch-aware-preloader/scripts/rc.preloadd">
<input type="hidden" name="#arg[1]" value="render">

<dl>
    <dt><label for="wap_server_type">Server type</label></dt>
    <dd>
        <select id="wap_server_type" name="SERVER_TYPE" size="1">
            <option value="emby"<?= (($wapCfg['SERVER_TYPE'] ?? 'emby') === 'emby') ? ' selected' : '' ?>>Emby</option>
        </select>
    </dd>
</dl>
<blockquote class="inline_help">Jellyfin support arrives in Phase 3.</blockquote>

<dl>
    <dt><label for="wap_server_url">Server URL</label></dt>
    <dd><input type="text" id="wap_server_url" name="SERVER_URL" value="<?= htmlspecialchars((string) ($wapCfg['SERVER_URL'] ?? 'http://localhost:8096')) ?>"></dd>
</dl>
<blockquote class="inline_help">Base URL of your Emby server, e.g. http://tower:8096</blockquote>

<dl>
    <dt>Users to preload</dt>
    <dd>
    <?php if (!$wapConnected) { ?>
        <em>Connect to a server to choose users: save the Server URL and API key above, then click <strong>Test connection</strong>.</em>
        <input type="hidden" name="USERS" value="<?= htmlspecialchars($wapCurUsers) ?>">
        <?php foreach ($wapSavedOverrides as $wapK => $wapV) { ?>
        <input type="hidden" name="<?= htmlspecialchars($wapK) ?>" value="<?= htmlspecialchars($wapV) ?>">
        <?php } ?>
    <?php } elseif (($wapUsers = wap_picker_users($wapPickers)) === []) { ?>
        <em>The server returned no users.</em>
        <input type="hidden" name="USERS" value="<?= htmlspecialchars($wapCurUsers) ?>">
        <?php foreach ($wapSavedOverrides as $wapK => $wapV) { ?>
        <input type="hidden" name="<?= htmlspecialchars($wapK) ?>" value="<?= htmlspecialchars($wapV) ?>">
        <?php } ?>
    <?php } else {
        // Rank order = DOM order. USERS[] checkboxes post in DOM order and the
        // engine reads that order as the rank, so rendering the enrolled users in
        // their saved csv order (unenrolled appended after) is the whole
        // mechanism - there is no separate rank key to persist.
        $wapEnrolled = [];
        $wapRest     = [];
        foreach ($wapUsers as $u) {
            $id = (string) ($u['id'] ?? '');
            if ($id === '') {
                continue; // an entry with no id cannot be persisted (empties are dropped)
            }
            $nm  = (string) ($u['name'] ?? $id);
            // The saved csv holds ids, or display names for a legacy selection.
            $pos = array_search($id, $wapSelUsers, true);
            if ($pos === false) {
                $pos = array_search($nm, $wapSelUsers, true);
            }
            if ($pos === false) {
                $wapRest[] = $u;
            } else {
                // Keyed by $pos would DROP a row: two users can match the same csv
                // index when one user's id equals another's display name (the
                // legacy name-based selection), and the later one would overwrite
                // the earlier. Carry the position alongside instead.
                $wapEnrolled[] = ['pos' => $pos, 'u' => $u];
            }
        }
        // PHP 8's sort is stable, so a shared $pos keeps $wapUsers order.
        usort($wapEnrolled, static fn (array $x, array $y): int => $x['pos'] <=> $y['pos']);
        $wapRanked = array_merge(array_column($wapEnrolled, 'u'), $wapRest);
        // Suffix -> how many users claim it, so a non-injective collision can be
        // detected before any override control is rendered.
        $wapKeyCounts = $wapKeyIdCounts($wapUsers);
        $wapUn        = 0;
        // Rank counter for the badges. Only enrolled users take a number, so it
        // is incremented per checked row, not per row.
        $wapRankNo = 0;
        ?>
        <div data-wap-order="" class="wap-order">
        <?php foreach ($wapRanked as $u) {
            $id      = (string) ($u['id'] ?? '');
            $nm      = (string) ($u['name'] ?? $id);
            $checked = (\in_array($id, $wapSelUsers, true) || \in_array($nm, $wapSelUsers, true));
            $wapUid  = 'wap_user_' . (++$wapUn);
            // No usable .cfg key for this id means rc.preloadd could never read an
            // override for it, so no override control is offered rather than a
            // dead one that silently does nothing. A suffix CLAIMED BY MORE THAN
            // ONE user is treated the same way: rendering both would emit two
            // inputs with one field name, and the save would keep only the last.
            $wapKeyId = $wapCfgKeyId($id);
            if ($wapKeyId !== null && ($wapKeyCounts[$wapKeyId] ?? 0) > 1) {
                $wapKeyId = null;
            }
            $wapOvNm  = $wapKeyId === null ? null : "TIER_ORDER_{$wapKeyId}";
            // Absence of the key IS inheritance; an empty value is a real, distinct
            // choice ("warm nothing"), so test presence, never truthiness.
            $wapHasOv = $wapOvNm !== null && \array_key_exists($wapOvNm, $wapCfg);
            // With no override saved, seed the panel from the global order so
            // ticking the box starts from what the user follows today.
            $wapUOrder = $wapHasOv ? $wapOrderList($wapCfg[$wapOvNm]) : $wapOrder;
            ?>
            <div data-wap-user="<?= htmlspecialchars($id) ?>" class="wap-user-row<?= $checked ? '' : ' wap-off' ?>">
                <div class="wap-user-head">
                    <?php
                    // Rank badge. Server-rendered so it is correct without JS;
                    // order.js renumbers it on a move or an enrollment toggle.
                    // Only enrolled users carry a number - rank is meaningless
                    // for someone not in the warm set.
            ?>
                    <span class="wap-rank" aria-hidden="true"><?= $checked ? (int) ++$wapRankNo : '' ?></span>
                    <input type="checkbox" id="<?= $wapUid ?>" name="USERS[]" value="<?= htmlspecialchars($id) ?>"<?= $checked ? ' checked' : '' ?>>
                    <label for="<?= $wapUid ?>"><?= htmlspecialchars($nm) ?></label>
                    <span class="wap-user-gap"></span>
                    <button type="button" data-wap-move="up" aria-label="Move <?= htmlspecialchars($nm) ?> up">&uarr;</button>
                    <button type="button" data-wap-move="down" aria-label="Move <?= htmlspecialchars($nm) ?> down">&darr;</button>
                </div>
            <?php if ($wapOvNm === null) { ?>
                <div class="wap-order-note"><em>This user's id cannot form a settings key, so a per-user order cannot be saved for them. They follow the global order.</em></div>
            <?php } else { ?>
                <div class="wap-order-note">
                    <input type="checkbox" id="<?= $wapUid ?>_ov" data-wap-override="<?= htmlspecialchars($wapOvNm) ?>"<?= $wapHasOv ? ' checked' : '' ?>>
                    <label for="<?= $wapUid ?>_ov">Override the global order</label>
                </div>
                <?php
                // TWO fields carry the override state, because one cannot.
                //
                // The hidden value field is DISABLED when the override is off, so it
                // is not posted and cannot overwrite the saved order. But NOT
                // posting is not enough to REMOVE: /update.php merges, seeding its
                // key map from the existing .cfg, so an unposted key survives with
                // its old value. Unticking was therefore a permanent no-op.
                //
                // So the state also rides in an ALWAYS-ENABLED '#wap_ov_<suffix>'
                // flag. '#'-prefixed fields reach $_POST but are never written to the
                // .cfg (the '#clear_api_key' idiom), and the presave turns an
                // explicit '0' into a real removal from update.php's key map. A
                // MISSING flag means "leave alone", so a save from a branch that
                // renders no user rows cannot wipe anything.
                //
                // Both states are rendered server-side rather than left to order.js,
                // so a no-JS save is faithful to what was already saved.
                ?>
                <input type="hidden" name="#wap_ov_<?= htmlspecialchars((string) $wapKeyId) ?>" data-wap-override-flag="<?= htmlspecialchars($wapOvNm) ?>" value="<?= $wapHasOv ? '1' : '0' ?>">
                <div data-wap-override-panel="<?= htmlspecialchars($wapOvNm) ?>" class="wap-order-panel"<?= $wapHasOv ? '' : ' hidden' ?>>
                    <input type="hidden" name="<?= htmlspecialchars($wapOvNm) ?>" value="<?= htmlspecialchars(implode(',', $wapUOrder)) ?>"<?= $wapHasOv ? '' : ' disabled' ?>>
                    <div data-wap-order="<?= htmlspecialchars($wapOvNm) ?>" class="wap-order">
                    <?php foreach ($wapOrderRows($wapUOrder) as $wapTok) {
                        [, $wapTlabel] = $wapAllTiers[$wapTok];
                        $wapRid = "{$wapUid}_t_{$wapTok}";
                        // UNNAMED on purpose: this box's state rides in the csv. A
                        // name would post a stray .cfg key and shadow the global
                        // TIER_<K>_ENABLED field the budget meter reads by name.
                        ?>
                        <div data-wap-tier="<?= htmlspecialchars($wapTok) ?>" class="wap-order-row">
                            <input type="checkbox" id="<?= $wapRid ?>"<?= \in_array($wapTok, $wapUOrder, true) ? ' checked' : '' ?>>
                            <label for="<?= $wapRid ?>"><?= htmlspecialchars($wapTlabel) ?></label>
                            <span class="wap-order-gap"></span>
                            <button type="button" data-wap-move="up" aria-label="Move <?= htmlspecialchars($wapTlabel) ?> up for <?= htmlspecialchars($nm) ?>">&uarr;</button>
                            <button type="button" data-wap-move="down" aria-label="Move <?= htmlspecialchars($wapTlabel) ?> down for <?= htmlspecialchars($nm) ?>">&darr;</button>
                        </div>
                    <?php } ?>
                    </div>
                </div>
            <?php } ?>
            </div>
        <?php } ?>
        </div>
    <?php } ?>
    </dd>
</dl>
<blockquote class="inline_help">Users whose watch-state is preloaded, highest priority first. Use the arrows to set rank. Rank breaks ties when the cache budget cannot cover everyone; it never starves a user of their top signal. Leave all unticked to include every user at equal rank.</blockquote>

<dl>
    <dt>Libraries to scope</dt>
    <dd>
